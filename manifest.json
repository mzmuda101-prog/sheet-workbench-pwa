{
  "name": "Sheet Workbench",
  "short_name": "Sheet Workbench",
  "description": "Local-first, offline przeglądarka i edytor arkuszy .xlsx/.csv — pliki nigdy nie opuszczają urządzenia.",
  "start_url": ".",
  "display": "standalone",
  "background_color": "#f3f1ea",
  "theme_color": "#2f6f5c",
  "icons": [
    {
      "src": "assets/images/favicon.png?v=20261114-logo",
      "sizes": "96x96",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/images/icon-192.png?v=20261114-logo",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/images/icon-512.png?v=20261114-logo",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/images/icon-maskable-192.png?v=20261114-logo",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "assets/images/icon-maskable-512.png?v=20261114-logo",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "file_handlers": [
    {
      "action": "./?open=file",
      "accept": {
        "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet": [
          ".xlsx"
        ],
        "application/vnd.ms-excel.sheet.macroEnabled.12": [
          ".xlsm"
        ]
      },
      "launch_type": "multiple-clients"
    }
  ],
  "launch_handler": {
    "client_mode": "navigate-new"
  },
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "file",
          "accept": [
            "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
            ".xlsx",
            "application/vnd.ms-excel.sheet.macroEnabled.12",
            ".xlsm"
          ]
        }
      ]
    }
  }
}
